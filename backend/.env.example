# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=sound_dj_booking

# Business Settings
GST_PERCENT=18
DEFAULT_ADVANCE_PERCENT=20
COMPANY_NAME=Sharma Sound & DJ Services
COMPANY_ADDRESS=Jabalpur, Madhya Pradesh, India
COMPANY_PHONE=+91-9876543210
COMPANY_GSTIN=23ABCDE1234F1Z5

# WhatsApp Notification (plug in Twilio WhatsApp Business API / Gupshup / Meta Cloud API here)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Seed accounts (created by `npm run db:init`)
SEED_SUPERADMIN_EMAIL=superadmin@sounddj.com
SEED_SUPERADMIN_PASSWORD=Super@123
SEED_ADMIN_EMAIL=admin@sounddj.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Sharma Sound & DJ Services
